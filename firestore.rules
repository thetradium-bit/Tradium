rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile: Each trader owns their own document.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Disallow accidental user profile deletion
    }

    // Chat Rooms: Authenticated traders can post, public read
    match /chatRooms/{channel}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated(); // For likesCount updates
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // Market sentiment counter
    match /marketSentiment/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Trading signals and leaderboard read
    match /signals/{signalId} {
      allow read: if true;
      allow write: if false; // Server or admin generated only
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
